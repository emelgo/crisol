# Copia este archivo a .env (fuera de git). Los valores de ejemplo son los del Compose de desarrollo.

# Servidor
HOST=127.0.0.1
PORT=8130

# Dirección pública del sitio (en desarrollo, la de Vite)
PUBLIC_URL=http://127.0.0.1:5173

# Firma de las sesiones: largo y aleatorio. Genera uno con: openssl rand -hex 32
AUTH_SECRET=

# Postgres y Valkey
DATABASE_URL=postgres://crisol:crisol@127.0.0.1:54330/crisol
VALKEY_URL=redis://127.0.0.1:63790

# Pruebas: servidor de Postgres donde se crean las bases de pruebas, y Valkey
TEST_DATABASE_URL=postgres://crisol:crisol@127.0.0.1:54330/crisol
TEST_VALKEY_URL=redis://127.0.0.1:63790
