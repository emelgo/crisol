# Copia este archivo a .env (fuera de git). Los valores de ejemplo son los del Compose de desarrollo.

# Servidor
HOST=127.0.0.1
PORT=8130

# Dirección pública del sitio (en desarrollo, la de Vite)
PUBLIC_URL=http://127.0.0.1:5173

# Firma de las sesiones: largo y aleatorio. Genera uno con: openssl rand -hex 32
AUTH_SECRET=
# Peticiones por minuto a las cuentas y al OAuth de la IA (de serie, 100; entrar y registrarse, siempre 5)
# AUTH_RATE_LIMIT_MAX=100

# Donde se guardan los bytes de los archivos (en archivos/ dentro); por defecto, datos-locales/ (fuera de git)
# DATA_DIR=

# El Chromium para sacar el PDF de las hojas; sin él, el que instala Playwright (pnpm exec playwright install chromium)
# CHROMIUM_PATH=

# Postgres y Valkey
DATABASE_URL=postgres://crisol:crisol@127.0.0.1:54330/crisol
VALKEY_URL=redis://127.0.0.1:63790
# El espacio de nombres de las colas en Valkey (por defecto, crisol)
# QUEUE_PREFIX=crisol

# Pruebas: servidor de Postgres donde se crean las bases de pruebas, y Valkey
TEST_DATABASE_URL=postgres://crisol:crisol@127.0.0.1:54330/crisol
TEST_VALKEY_URL=redis://127.0.0.1:63790

# Entrar con Discord y Google: pospuesto (de momento, solo email y contraseña). Cada proveedor se activará al rellenar
# sus dos variables, con una aplicación OAuth que apunte a PUBLIC_URL
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Correo saliente (recuperar la contraseña y verificar el email): pospuesto con lo anterior
# SMTP_URL=
# MAIL_FROM=
