{
  "name": "@crisol/server",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./bootstrap": "./src/bootstrap.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "crisol": "node --env-file-if-exists=../../.env src/cli/main.ts",
    "auth:schema": "auth generate --config better-auth.config.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/cimd": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@crisol/contracts": "workspace:*",
    "@crisol/db": "workspace:*",
    "@crisol/domain": "workspace:*",
    "@fastify/rate-limit": "catalog:",
    "@fastify/static": "catalog:",
    "@fastify/websocket": "catalog:",
    "@hocuspocus/server": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "y-protocols": "catalog:",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hocuspocus/provider": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "auth": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
