{
  "name": "crisol",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "licencias": "node scripts/licencias.ts",
    "sala-limpia": "node scripts/sala-limpia.ts",
    "test:coverage": "turbo run test:coverage",
    "cobertura-diff": "node scripts/cobertura-diff.ts",
    "limites": "depcruise --config .dependency-cruiser.cjs apps packages scripts e2e",
    "servicios": "docker compose up -d --wait",
    "dev": "docker compose up -d --wait && turbo run dev",
    "db:migrate": "pnpm --filter @crisol/db migrate",
    "build": "turbo run build",
    "e2e": "pnpm --filter @crisol/web build && pnpm --filter @crisol/e2e e2e && pnpm --filter @crisol/e2e e2e:fugas && pnpm --filter @crisol/e2e e2e:a11y",
    "crisol": "pnpm --filter @crisol/server crisol"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@swc/core": "catalog:",
    "dependency-cruiser": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
